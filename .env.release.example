# Copy to `.env.release` (git-ignored). Only holds local release state; signing passwords live in
# keystore.properties.
#
# Play rejects an upload whose versionCode is not strictly greater than the last one:
#
#   pnpm play:internal         fastlane asks Play for the highest code across every track,
#                              builds with max + 1, and writes it back here.
#   pnpm release:android:aab   no Play in the loop: reads the LAST code used from here (or the
#                              versionCode in app.json, whichever is higher), builds with + 1,
#                              and writes it back once gradle succeeds.
#
# Setting ANDROID_VERSION_CODE in the environment uses that value as-is and writes nothing back
# (unless ANDROID_VERSION_CODE_PERSIST=1).
ANDROID_VERSION_CODE=0

# Copy to keystore.properties in the project root (that file is gitignored).
#
# Gradle does not read .env. Either use this file, or export the same values
# in your shell before building, e.g. NOCTA_KEY_ALIAS, NOCTA_KEYSTORE_PASSWORD, NOCTA_KEY_PASSWORD.
#
# release.keystore and this file must sit next to package.json (repo root),
# not inside the android/ folder. Gradle resolves that path via rootProject.

keyAlias=your-key-alias
storePassword=your-keystore-password
keyPassword=your-key-password

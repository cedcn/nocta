{
  "name": "nocta",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "prebuild": "expo prebuild --clean",
    "prebuild:android": "expo prebuild --clean --platform android",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "keystore:android": "bash scripts/create-android-keystore.sh",
    "release:android": "bash scripts/release-android.sh apk",
    "release:android:aab": "bash scripts/release-android.sh aab",
    "play:doctor": "bundle exec fastlane android doctor",
    "play:internal": "bundle exec fastlane android release",
    "play:alpha": "bundle exec fastlane android release track:alpha",
    "play:testing": "bundle exec fastlane android release track:internal,alpha",
    "play:production": "bundle exec fastlane android release track:production",
    "play:promote": "bundle exec fastlane android promote from:internal to:production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "^5.1.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.16.0",
    "expo": "~55.0.6",
    "expo-asset": "~55.0.20",
    "expo-audio": "~55.0.8",
    "expo-build-properties": "^55.0.9",
    "expo-constants": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-keep-awake": "~55.0.8",
    "expo-linear-gradient": "~55.0.14",
    "expo-localization": "~55.0.19",
    "expo-location": "~55.1.14",
    "expo-notifications": "~55.0.27",
    "expo-secure-store": "~55.0.18",
    "expo-status-bar": "~55.0.4",
    "i18next": "^26.4.2",
    "lottie-react-native": "~7.3.8",
    "lucide-react-native": "^1.17.0",
    "react": "19.2.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.83.2",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "15.15.3"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-native": "^0.72.8",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript": "^5.9.3"
  }
}

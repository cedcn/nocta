{
  "expo": {
    "name": "nocta",
    "slug": "nocta",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16130F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nocta.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111B81",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.nocta.app",
      "versionCode": 3,
      "compileSdkVersion": 36,
      "targetSdkVersion": 36,
      "buildToolsVersion": "36.0.0",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidReleaseSigning",
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "extraMavenRepos": [
              "https://maven.google.com"
            ],
            "extraProguardRules": "",
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so"
              ]
            }
          }
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nocta uses your approximate location to recommend sounds that match the local weather."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/ringtones/chime.m4a",
            "./assets/ringtones/ding.m4a",
            "./assets/ringtones/marimba.m4a",
            "./assets/ringtones/windchime.m4a"
          ]
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/BebasNeue.ttf",
            "./assets/fonts/OswaldBold.ttf"
          ]
        }
      ]
    ]
  }
}
